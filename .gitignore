# 依赖
node_modules/

# 构建产物（由 npm run build:embed 生成，发版流水线自动构建）
dist/

# 运行时数据
data/
npm-debug.log*
puppeteer_data/
puppeteer_data*
h/

# 环境变量与密钥
.env
.env.local
.env.*.local

# 数据备份（勿提交到仓库，用 paranote export 生成并异地保存）
paranote-backup-*.json
*.backup.json
*.bak

# 测试与构建输出
coverage/

# 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
